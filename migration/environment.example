# Somente ambiente local/isolado; nunca configurar em produção.
NEXT_PUBLIC_DATA_BACKEND=neon-migration
NEON_MIGRATION_ENABLED=true
# Preencher privadamente, sem publicar valores:
# O usuario da URL do banco DEVE ser coroinhas_gateway; nunca coroinhas_owner.
# Use somente a branch Neon migration-coroinhas-20261106.
NEON_MIGRATION_DATABASE_URL=
# URL do Neon Auth da branch de homologação; nunca use URL da produção.
NEON_AUTH_BASE_URL=
# Segredo aleatório privado, com alta entropia, exclusivo da homologação.
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente para auditoria offline e sincronização, nunca usar no site ou na Vercel:
# Credencial de coroinhas_owner EXCLUSIVA da branch de homologação.
NEON_MIGRATION_ADMIN_DATABASE_URL=
# Somente para execução manual da sincronização:
SOURCE_READONLY_DATABASE_URL=
MIGRATION_SOURCE_PROJECT=dsglwwwwdtjynipauvrp

# Alvo isolado escolhido para auditoria e ENSAIO. Nunca mudar diretamente a produção.
MIGRATION_TARGET_BRANCH_ID=br-odd-bread-bc1jxzsh

# Valores ABAIXO são somente um checklist para futuro cutover AUTORIZADO.
# Não definir em produção antes do backup validado, login real e autorização.
# NEON_PRODUCTION_CUTOVER_ENABLED=false
# NEON_PRODUCTION_APPROVED_COMMIT=
# NEON_PUSH_DISPATCH_ENABLED=false
